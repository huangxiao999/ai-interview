# Copy to .env for local development. Replace this placeholder before starting PostgreSQL.
DB_PASSWORD=REPLACE_WITH_A_LOCAL_PASSWORD
DB_USERNAME=interview_coach
DB_NAME=interview_coach
DB_PORT=15432
# local profile selects the app schema through Hikari; Flyway owns application/session tables.
DB_URL=jdbc:postgresql://127.0.0.1:15432/interview_coach
# Relative to backend/; use forward slashes if setting a local absolute path. Never a web/static directory.
PRIVATE_FILE_ROOT=../.local-data/private

# Default OFF. Merely supplying a Key/endpoint never authorizes external calls.
# Enable only after separate account/policy checks and explicit call-scope authorization.
# JVM startup (before -jar) must also include all three flags; late System.setProperty is rejected:
# -Djdk.httpclient.redirects.retrylimit=1 -Djdk.httpclient.disableRetryConnect=true -Djdk.httpclient.enableAllMethodRetry=false
BAILIAN_EMBEDDING_ENABLED=false
DASHSCOPE_API_KEY=
BAILIAN_EMBEDDING_WORKSPACE=
# Full Beijing workspace-native POST endpoint; not a Base URL or compatible-mode URL.
# https://<workspace>.cn-beijing.maas.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
BAILIAN_EMBEDDING_ENDPOINT=
# Model/dimension/type are fixed in code: qwen3.7-text-embedding-flash / 1024 / document / dense.
