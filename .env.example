# Copy to .env for local development. Replace this placeholder before starting PostgreSQL.
DB_PASSWORD=REPLACE_WITH_A_LOCAL_PASSWORD
DB_USERNAME=interview_coach
DB_NAME=interview_coach
DB_PORT=15432
# local profile selects the app schema through Hikari; Flyway owns application/session tables.
DB_URL=jdbc:postgresql://127.0.0.1:15432/interview_coach
